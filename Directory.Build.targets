<Project>
  <!-- ProjectReference does not import NuGet buildTransitive assets. Exercise the same target locally. -->
  <Import Project="$(MSBuildThisFileDirectory)src/mGO.Log/buildTransitive/mGO.Log.targets"
          Condition="'$(MSBuildProjectName)' != 'mGO.Log' and '$(MSBuildProjectName)' != 'mGO.Log.Abstractions' and '$(MSBuildProjectName)' != 'mGO.Log.Extensions.Hosting'" />
</Project>
