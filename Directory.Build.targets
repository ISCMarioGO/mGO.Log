<Project>
  <!-- ProjectReference does not import NuGet buildTransitive assets. Exercise the same target locally. -->
  <Import Project="$(MSBuildThisFileDirectory)src/GO.Log/buildTransitive/GO.Log.targets"
          Condition="'$(MSBuildProjectName)' != 'GO.Log' and '$(MSBuildProjectName)' != 'GO.Log.Abstractions' and '$(MSBuildProjectName)' != 'GO.Log.Extensions.Hosting'" />
</Project>
