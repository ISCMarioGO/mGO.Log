{
  "GOLog": {
    "Enabled": true,
    "ApplicationName": "Sample.Api",
    "MinimumLevel": "Information",
    "IncludeScopes": true,
    "IncludeActivityTracking": true,
    "IncludeExecutionContext": true,
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "AppendOnStartup": false,
      "FileNamePattern": "{application}-{date}-{sequence}.log",
      "Format": "Text",
      "Text": {
        "Style": "Standard",
        "TimestampFormat": "O",
        "IncludeProperties": true,
        "IncludeScopes": true,
        "IncludeExceptionDetails": true
      },
      "MaxFileSizeMB": 10,
      "RetentionDays": 7,
      "MaxRetainedFiles": 30,
      "FlushIntervalSeconds": 1
    },
    "Console": {
      "Enabled": false,
      "UseColors": true,
      "StandardErrorFromLevel": "Warning",
      "Text": {
        "Style": "Compact",
        "TimestampFormat": "O",
        "IncludeProperties": true,
        "IncludeScopes": true,
        "IncludeExceptionDetails": true
      }
    },
    "Queue": {
      "Capacity": 4096,
      "BatchSize": 64,
      "FullMode": "RejectNew",
      "ShutdownTimeoutSeconds": 10
    },
    "Security": {
      "MaskSensitiveData": true,
      "SensitiveKeys": [ "password", "token", "authorization", "secret", "apiKey", "connectionString" ],
      "MaxPropertyDepth": 5,
      "MaxMessageLength": 16384,
      "MaxProperties": 64
    }
  },
  "AllowedHosts": "*"
}
