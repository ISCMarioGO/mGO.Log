{
  "GOLog": {
    "ApplicationName": "Sample.Console",
    "MinimumLevel": "Trace",
    "File": {
      "Directory": "logs",
      "AppendOnStartup": false,
      "Format": "Text",
      "Text": {
        "Style": "Trace",
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff 'UTC'"
      }
    },
    "Console": {
      "Enabled": true,
      "UseColors": true,
      "StandardErrorFromLevel": "Warning",
      "Text": {
        "Style": "Compact",
        "IncludeScopes": false,
        "IncludeProperties": false
      }
    }
  }
}
